<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Pipes</AssemblyName>
    <!-- Per-monitor DPI awareness is also set in code before any GL window exists (see Program.Main). -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Gives the built exe/scr its icon in Explorer, the taskbar, and shortcuts. At runtime the GL window and the
         settings dialog both pull the same icon back out of the exe (see GLHost.CreateWindow and ConfigForm's
         constructor) rather than embedding it a second time. Regenerate with scripts/make_icon.py. -->
    <ApplicationIcon>Pipes.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
  </ItemGroup>

</Project>